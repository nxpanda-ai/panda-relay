# shell scripts run on Linux: LF whatever core.autocrlf says
*.sh text eol=lf
# Linux deployment files (systemd unit, Caddyfile): LF whatever core.autocrlf says
docs/deploy/** text eol=lf
# gofmt and `codegen --check` compare bytes: generated / Go sources stay LF on a Windows clone (core.autocrlf=true)
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.g.cs text eol=lf
